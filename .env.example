# openmohaa-server-kit settings. Copy to .env and edit:
#   cp .env.example .env
# Values must not contain double quotes ("), semicolons (;) or line breaks.
# Anything not listed here goes in custom/custom.cfg.

# ===== Server =====
SERVER_HOSTNAME=OpenMoHAA Server
# Remote console password: at least 8 characters, no spaces, not "changeme".
# Leave empty to disable RCON. Generate one with: openssl rand -base64 18
RCON_PASSWORD=
# Password players need to join. Empty = open server.
SERVER_PASSWORD=
# List the server in the in-game browser (1) or not (0).
PUBLIC_LISTING=1

# ===== Game =====
# 1 Free for All, 2 Team, 3 Round, 4 Objective, 5 Tug-of-War, 6 Liberation.
# The rotation must hold maps for the chosen type (dm/ for 1-3, obj/ for 4).
GAME_TYPE=1
MAP_ROTATION=dm/mohdm1 dm/mohdm2 dm/mohdm3 dm/mohdm4 dm/mohdm5 dm/mohdm6 dm/mohdm7
# Map to start on. Empty = first map in MAP_ROTATION.
START_MAP=
# Objective example:
# GAME_TYPE=4
# MAP_ROTATION=obj/obj_team1 obj/obj_team2 obj/obj_team3 obj/obj_team4
TIME_LIMIT=10
FRAG_LIMIT=100
ROUND_LIMIT=0
TEAM_DAMAGE=0
# 0 Allied Assault, 1 Spearhead, 2 Breakthrough (needs the expansion files).
GAME_TARGET=0

# ===== Players and bots =====
# MAX_CLIENTS + MAX_BOTS must be 64 or less.
MAX_CLIENTS=24
MAX_BOTS=40
# Fill with bots until this many players are on (0 = off).
BOT_FILL_MIN_PLAYERS=0
# Fixed number of bots to spawn (0 = none).
BOT_COUNT=0

# ===== Downloads =====
# Base URL where clients can download your custom .pk3 files (see
# docs/faq/nginx-downloads.md). Empty = downloads off.
DOWNLOAD_URL=

# ===== Host (read by compose.yaml) =====
# UDP ports; open both in your firewall.
GAME_PORT=12203
GAMESPY_PORT=12300
# Folder holding main/pak*.pk3 (from scripts/prepare-game-files.sh).
GAME_DIR=./game
# Image tag to run, e.g. 0.1.0. Pin a version for stable hosting.
KIT_VERSION=latest
# Container resource limits.
MEM_LIMIT=1g
CPU_LIMIT=2
